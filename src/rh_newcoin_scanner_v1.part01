const BACKFILL_RPC_GAP_MS = Number(process.env.BACKFILL_RPC_GAP_MS || 220);
const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

function isRateLimitError(e) {
  const t = String(e?.message || e || '');
  return e?.status === 429 || e?.statusCode === 429 || /(^|\D)429(\D|$)|Too Many Requests/i.test(t);
}

async function backfillGetLogs(args, label = 'getLogs') {
  const waits = [0, 450, 1200, 2500];
  let last;
  for (let i = 0; i < waits.length; i++) {
    if (waits[i]) await sleep(waits[i]);
    try {
      const out = await httpClient.getLogs(args);
      if (BACKFILL_RPC_GAP_MS > 0) await sleep(BACKFILL_RPC_GAP_MS);
      return out;
    } catch (e) {
      last = e;
      if (!isRateLimitError(e) || i === waits.length - 1) throw e;
      console.warn(`[backfill-rate-limit] ${label} retry=${i + 1}`);
    }
  }
  throw last;
}

async function runBackfillSource(label, getLogsArgs, handler) {
  try {
    const logs = await backfillGetLogs(getLogsArgs, label);
    for (const log of logs) await handler(log);
    return { label, ok: true, count: logs.length };
  } catch (e) {
    console.warn('[backfill-source]', label, String(e?.message || e));
    return { label, ok: false, count: 0, error: String(e?.message || e) };
  }
}

