  id: CHAIN_ID, name: 'Robinhood Chain', nativeCurrency: { name: 'Ether', symbol: 'ETH', decimals: 18 },
  rpcUrls: { default: { http: [HTTP_URL], webSocket: [WS_URL] } }
};
const httpClient = createPublicClient({ chain, pollingInterval: 2000, transport: http(HTTP_URL, { timeout: 15_000, retryCount: 2 }) });
const liveClient = WS_URL
  ? createPublicClient({ chain, transport: webSocket(WS_URL, { keepAlive: true }) })
  : httpClient; // 无 WebSocket key 时可用公共 RPC 轮询做功能验证，生产环境仍建议 WebSocket。

