  if (failures) lastError = `trade backfill: ${failures} source(s) failed`;
}

async function backfillRecent() {
  // Railway 重启/重新部署时回补最近区块，降低短暂离线造成的漏扫。
  const head = await httpClient.getBlockNumber();
  latestBlock = head;
  const from = head > BACKFILL_BLOCKS ? head - BACKFILL_BLOCKS : 0n;
  const specs = [
    ['pools.trade Current', { address: ADDR.POOLS_TRADE_CURRENT, event: poolsTradeTokenCreated, fromBlock: from, toBlock: head }, l => onPoolsTradeTokenCreated(l, 'Current')],
    ['pools.trade Original', { address: ADDR.POOLS_TRADE_ORIGINAL, event: poolsTradeTokenCreated, fromBlock: from, toBlock: head }, l => onPoolsTradeTokenCreated(l, 'Original')],
    ['Pons Current', { address: ADDR.PONS_CURRENT, event: ponsV1Launch, fromBlock: from, toBlock: head }, l => onPonsV1Launch(l, 'Pons Current')],
    ['Pons Legacy', { address: ADDR.PONS_LEGACY, event: ponsV1Launch, fromBlock: from, toBlock: head }, l => onPonsV1Launch(l, 'Pons Legacy')],
    ['Pons V2', { address: ADDR.PONS_V2, event: ponsV2Launch, fromBlock: from, toBlock: head }, onPonsV2Launch],
    ['Uni V3', { address: ADDR.V3_FACTORY, event: v3PoolCreated, fromBlock: from, toBlock: head }, onGenericV3Pool],
    ['Uni V4', { address: ADDR.V4_POOL_MANAGER, event: v4Initialize, fromBlock: from, toBlock: head }, onGenericV4Pool],
  ];
  const results = [];
  for (const [label, args, handler] of specs) results.push(await runBackfillSource(label, args, handler));
  const failed = results.filter(x => !x.ok);
  if (failed.length) lastError = `startup backfill: ${failed.length}/${results.length} sources failed`;
  await replayHistoricalTrades(from, head);
  console.log(`[backfill] blocks ${from}-${head}, sources=${results.length}, failed=${failed.length}, rpcGapMs=${BACKFILL_RPC_GAP_MS}`);
}

const STATUS_VERSION = 'rh-newcoin-scanner-v1.6.5';

// Public Robinhood RPC explicitly returns messages such as
// "Rate Limit Hit, limit will reset in 60 seconds". Short retries only burn the
// remaining quota, so startup/backfill honors the advertised reset window.
function publicRpcRateLimitWaitMs_(err, attempt) {
  const text = String(err?.message || err || '');
  const isLimited = isRateLimitError(err) || /Rate Limit Hit|rate.?limit|reset in\s+\d+\s*seconds/i.test(text);
  if (!isLimited) return 0;
  const m = text.match(/reset in\s+(\d+)\s*seconds/i);
  if (m) return Math.min(70_000, (Number(m[1]) + 2) * 1000);
  return [5_000, 15_000, 30_000, 60_000][Math.min(attempt, 3)];
}

backfillGetLogs = async function(args, label = 'getLogs') {
  let last;
  for (let attempt = 0; attempt < 4; attempt++) {
    try {
      const out = await httpClient.getLogs(args);
      if (BACKFILL_RPC_GAP_MS > 0) await sleep(BACKFILL_RPC_GAP_MS);
      return out;
    } catch (err) {
      last = err;
      const waitMs = publicRpcRateLimitWaitMs_(err, attempt);
      if (!waitMs || attempt === 3) throw err;
      console.warn(`[backfill-rate-limit] ${label} wait=${Math.round(waitMs / 1000)}s retry=${attempt + 1}`);
      await sleep(waitMs);
    }
  }
  throw last;
};

// Same-block Pons V2 first-trade check. During startup it uses the throttled
// backfill path. In steady state it makes one immediate Buy query first; most
// launches with an initial buy therefore never need a long-lived curve watcher.
backfillLaunchCurve = async function(curve, token, symbol, q, blockNumber, txHash) {
  if (blockNumber == null || !txHash) return;
  const getLogs = async (event, label) => {
    const args = { address: safeAddress(curve), event, fromBlock: blockNumber, toBlock: blockNumber };
    return ready ? httpClient.getLogs(args) : backfillGetLogs(args, label);
  };

  const buys = await getLogs(curveBuy, `${symbol || token}:launch-buy`).catch(() => []);
  const sameBuys = Array.isArray(buys) ? buys.filter(x => lc(x.transactionHash) === lc(txHash)) : [];
  if (sameBuys.length) {
    await processCurveLogs(sameBuys, curve, token, symbol, q, 'buy');
    return;
  }

  const sells = await getLogs(curveSell, `${symbol || token}:launch-sell`).catch(() => []);
  const sameSells = Array.isArray(sells) ? sells.filter(x => lc(x.transactionHash) === lc(txHash)) : [];
  if (sameSells.length) await processCurveLogs(sameSells, curve, token, symbol, q, 'sell');
};

// Keep no-trade Pons V2 curve watchers bounded. A curve watcher stops as soon as
// the first trade is captured, or after 120 seconds if the launch remains idle.
watchCurve = async function(curve, token, symbol, q) {
  const key = lc(curve);
  const s = ensureState(token);
  if (s.firstTradeSent || watchedCurves.has(key)) return;

  watchedCurves.add(key);
  let uBuy = null;
  let uSell = null;
  let timer = null;
  let stopped = false;

  const stop = () => {
    if (stopped) return;
    stopped = true;
    try { if (typeof uBuy === 'function') uBuy(); } catch {}
    try { if (typeof uSell === 'function') uSell(); } catch {}
    if (timer) clearTimeout(timer);
    watchedCurves.delete(key);
    if (s.curveWatchStop === stop) delete s.curveWatchStop;
  };

  const onBuyLogs = async logs => {
    if (!Array.isArray(logs)) return;
    await processCurveLogs(logs, curve, token, symbol, q, 'buy').catch(() => {});
    if (lastError.startsWith(`curve buy ${curve}:`)) lastError = '';
    if (s.firstTradeSent) stop();
  };

  const onSellLogs = async logs => {
    if (!Array.isArray(logs)) return;
    await processCurveLogs(logs, curve, token, symbol, q, 'sell').catch(() => {});
    if (lastError.startsWith(`curve sell ${curve}:`)) lastError = '';
    if (s.firstTradeSent) stop();
  };

  uBuy = liveClient.watchContractEvent({
    address: safeAddress(curve), event: curveBuy, onLogs: onBuyLogs,
    pollingInterval: WS_URL ? undefined : 3000,
    onError: err => { lastError = `curve buy ${curve}: ${String(err?.message || err || 'unknown error')}`; }
  });
  uSell = liveClient.watchContractEvent({
    address: safeAddress(curve), event: curveSell, onLogs: onSellLogs,
    pollingInterval: WS_URL ? undefined : 3000,
    onError: err => { lastError = `curve sell ${curve}: ${String(err?.message || err || 'unknown error')}`; }
  });

  if (typeof uBuy === 'function') unwatchers.push(uBuy);
  if (typeof uSell === 'function') unwatchers.push(uSell);
  s.curveWatchStop = stop;
  timer = setTimeout(stop, 120_000);
  timer.unref?.();
};

onPonsV2Launch = async function(log) {
  if (!markEventOnce(log, 'pons-v2')) return;
  const { token, curve, deployer, pairToken } = log.args || {};
  if (!token || !curve) return;
  const ctx = await blockContext(log.blockNumber);
  const [m, q] = await Promise.all([tokenMeta(token), quoteMeta(pairToken)]);
  const s = ensureState(token, {
    symbol: m.symbol, source: 'Pons V2', deployer, pair: safeAddress(curve),
    quoteToken: safeAddress(pairToken), quoteSymbol: q.symbol, curve: safeAddress(curve),
    trustedPons: true, dexVersion: 'Curve', discoveryBlock: log.blockNumber
  });
  console.log('[DISCOVERY] Pons V2', m.symbol, token, 'curve', curve, `lag=${ctx.age_seconds}s`);
  await post('TOKEN_DISCOVERED', {
    ...ctx, block_number: Number(log.blockNumber), tx_hash: log.transactionHash,
    token_ca: safeAddress(token), symbol: m.symbol, source: 'Pons V2', launchpad: 'Pons V2', deployer: safeAddress(deployer),
    pair: safeAddress(curve), quote_token: safeAddress(pairToken), quote_symbol: q.symbol, stock_pair: q.stock_pair,
    mechanism_tags: q.stock_pair === '待识别' ? 'custom-pair,curve' : 'curve', dex_version: 'Curve', discovery_tx: log.transactionHash, stage: 'Discovery'
  });

  await backfillLaunchCurve(curve, token, m.symbol, q, log.blockNumber, log.transactionHash).catch(err => {
    lastError = `launch trade ${curve}: ${String(err?.message || err)}`;
  });
  if (!s.firstTradeSent) await watchCurve(curve, token, m.symbol, q).catch(err => {
    lastError = `curve watch ${curve}: ${String(err?.message || err)}`;
  });
  scheduleSnapshots(token);
  s.discoveredAt = Date.now();
};

// Recover from stale webhook errors. A later successful webhook clears only a
// webhook-specific stale error; RPC/listener/holder errors remain visible.
const rawPost = post;
post = async function(event_type, body = {}) {
  if (typeof event_type !== 'string' || !event_type.trim()) {
    throw new Error('event_type is required and must be a non-empty string');
  }
  const result = await rawPost(event_type, body);
  if (
    lastError.startsWith('Webhook HTTP ') ||
    lastError.startsWith('Webhook rejected:')
  ) {
    lastError = '';
  }
  return result;
};

const healthServer = createServer((req, res) => {
  if (req.url !== '/health' && req.url !== '/') {
    res.writeHead(404, { 'content-type': 'application/json' });
    return res.end(JSON.stringify({ ok: false, error: 'not_found' }));
  }
  const body = {
    ok: ready, version: STATUS_VERSION, chain_id: CHAIN_ID, latest_block: Number(latestBlock || 0n),
    mode: WS_URL ? 'websocket' : 'http-polling', dry_run: DRY_RUN, webhook_ok: webhookOk,
    event_lag_seconds: Number(lastLag.toFixed(2)), queue_size: queueSize,
    tracked_tokens: state.size, watched_pools: watchedPools.size, watched_curves: watchedCurves.size, watched_v4_pools: v4Pools.size,
    stock_tokens: stockTokens.size, uptime_seconds: Math.floor((Date.now() - startedAt) / 1000),
    last_error: lastError || ''
  };
  res.writeHead(ready ? 200 : 503, { 'content-type': 'application/json', 'cache-control': 'no-store' });
  res.end(JSON.stringify(body));
});
healthServer.listen(PORT, '0.0.0.0', () => console.log(`[health] listening on 0.0.0.0:${PORT}`));

function shutdown(signal) {
  console.log(`[shutdown] ${signal}`);
  ready = false;
  for (const u of unwatchers.splice(0)) { try { u(); } catch {} }
  healthServer.close(() => process.exit(0));
  setTimeout(() => process.exit(0), 8000).unref?.();
}
process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));

setInterval(() => {
  post('HEARTBEAT', {
    event_time: nowIso(), ok: true, latest_block: Number(latestBlock || 0n),
    ws_provider: WS_URL ? (WS_URL.includes('alchemy.com') ? 'Alchemy WebSocket' : 'Custom WebSocket') : 'Public HTTP polling',
    ws_status: WS_URL ? 'connected' : 'polling',
    event_lag_seconds: Number(lastLag.toFixed(2)), reconnect_count: WS_URL ? reconnectCount : 0, queue_size: queueSize,
    last_discovery_write: lastDiscoveryWrite, last_error: lastError, scanner_version: STATUS_VERSION,
    pools_trade_current_listener: '正常', pools_trade_original_listener: '回补保留/实时停用',
    pons_current_listener: '正常', pons_legacy_listener: '正常', pons_v2_listener: '正常',
    pons_first_trade_listener: watchedCurves.size >= 0 ? '正常' : '警告',
    v3_listener: '正常', v4_listener: '正常'
  }).catch(() => {});
}, 30_000).unref?.();

process.on('unhandledRejection', e => { lastError = `unhandledRejection: ${String(e)}`; console.error(lastError); });
process.on('uncaughtException', e => { lastError = `uncaughtException: ${String(e?.stack || e)}`; console.error(lastError); });

console.log(`${STATUS_VERSION} starting on chain ${CHAIN_ID} mode=${DRY_RUN ? 'DRY_RUN' : 'LIVE'}`);
await refreshStockRegistry();
setInterval(refreshStockRegistry, 60 * 60 * 1000).unref?.();

// Backfill first so startup does not stack seven live polling loops on top of the
// historical scan. The head captured by backfillRecent remains in latestBlock;
// once watchers start, their first poll covers blocks produced during startup.
await backfillRecent();
startWatchers();

await post('HEARTBEAT', {
  event_time: nowIso(), ok: true, latest_block: Number(latestBlock || 0n),
  ws_provider: WS_URL ? (WS_URL.includes('alchemy.com') ? 'Alchemy WebSocket' : 'Custom WebSocket') : 'Public HTTP polling',
  ws_status: WS_URL ? 'connected' : 'polling',
  reconnect_count: WS_URL ? reconnectCount : 0,
  queue_size: queueSize,
  scanner_version: STATUS_VERSION
}).catch(() => {});
ready = true;
console.log('watchers active');
